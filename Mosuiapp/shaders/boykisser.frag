float render_sdf(vec2 uv, float time)
{
    float d = 0.0;
    
    for (int i = 0; i < determine_quality(time); ++i)
    {
        vec4 t = SDF_TERMS[i];
        d += t.z * cos(6.28318530718 * (t.x * uv.x + t.y * (uv.y * -1.)) + t.w);
    }

    return d;
}

void mainImage( out vec4 O, in vec2 I )
{
    vec2 uv = (I/R.xy - vec2(.5, 0.)) * zoom + vec2(.5, 0.);
    uv.x = (uv.x - .5) * aspect + .5;
    
    float rand_vert_offs = rand(vec2(ceil(uv.x), floor(uv.x)));
    float rand_speed = speed + rand_vert_offs;
    float rand_time = iTime * rand_speed + rand_vert_offs * 10.;
    
    float jump = pow(abs(sin(rand_time * PI)), .7);
    uv.y -= jump * height;
    
    float sdf = clamp((1. - render_sdf(uv, rand_time)) / 100.f, 0., 1.);
    float glow = 0.03 / sdf;
    
    vec3 rainbow = 0.5 + 0.5 * cos(iTime + uv.xyx + vec3(0,2,4));
    vec4 col = vec4(glow * rainbow, 1.);
    O = col * float(uv.y < 1.) * (float(uv.y > 0.));
}

void main() {
    mainImage(fragColor, fragCoord);
}