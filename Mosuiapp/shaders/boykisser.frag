float rand(vec2 co){ return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453); }

const int QUALITY_ITER = 5;
const int QUALITY_ARR[QUALITY_ITER] = int[](
    64,
    128,
    256,
    512,
    2048
);

int determine_quality(float time)
{
    float x = fract(time / float(QUALITY_ITER));
    int i = QUALITY_ITER - int(floor(float(QUALITY_ITER) * x));
    return QUALITY_ARR[i - 1];
}

